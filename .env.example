ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

ENCRYPTION_SERVICE_KEY=<ENCRYPTION_SERVICE_KEY>

YANDEX_SERVICE_URL=http://eqsitecms-yandex-service:8000
SEO_SERVICE_URL=http://eqsitecms-seo-service:8000
# Согласовать с SEO_UTC_OFFSET_HOURS в seo-service: общий локальный день слота/окна.
YA_METRICA_UTC_OFFSET_HOURS=3
YA_METRICA_STAT_PAGE_LIMIT=100000
YA_METRICA_STAT_TIMEOUT_SECONDS=120
SEO_RESOLVE_BATCH_SIZE=1000
PARSE_DISPATCH_INTERVAL_SECONDS=30
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=60
TASK_LEASE_SECONDS=600

# Operator supplies the existing Redis password in THIS service's .env.
# CelerySettings injects/escapes REDIS_PASSWORD into these URLs at runtime.
REDIS_PASSWORD=<REDIS_PASSWORD>
CELERY_APP_MAIN=ya-metrica-service
CELERY_APP_BROKER=redis://eqsitecms-redis:6379/5
CELERY_APP_BACKEND=redis://eqsitecms-redis:6379/6
WORKER_CONCURRENCY=1

# NATS: доверенная внутренняя сеть; stream создаёт только seo-service.
# Несколько серверов разделяются запятой. Реальный .env настраивает оператор.
NATS_SERVERS=nats://eqsitecms-nats:4222
NATS_STREAM_PARSE_COMMANDS=PARSE_COMMANDS
NATS_SUBJECT_PARSE_RUN=commands.parse.ya_metrica.run
NATS_CONSUMER_PARSE_RUN=ya-metrica-parse-run
NATS_CONSUMER_ACK_WAIT_SECONDS=30
NATS_CONSUMER_MAX_DELIVER=5
NATS_CONSUMER_FETCH_BATCH_SIZE=1
NATS_CONSUMER_FETCH_TIMEOUT_SECONDS=5
NATS_SETUP_MAX_ATTEMPTS=10
NATS_SETUP_BACKOFF_SECONDS=2
NATS_ERROR_REPORT_AFTER_ATTEMPTS=3
